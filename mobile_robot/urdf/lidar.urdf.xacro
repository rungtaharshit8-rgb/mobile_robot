<robot>

<link name="lidar_link">
<visual>
<geometry>
<cylinder radius="0.06" length="0.04"/>
</geometry>
<material name="black">
<color rgba="0.1 0.1 0.1 1.0"/>
</material>
</visual>
<collision>
<geometry>
<cylinder radius="0.06" length="0.04"/>
</geometry>
</collision>
<inertial>
<mass value="0.1"/>
<origin xyz="0 0 0"/>
<inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025"/>
</inertial>
</link>
<!--
 ── Fixed joint to base ───────────────────────────────────────── 
-->
<joint name="lidar_joint" type="fixed">
<parent link="base_link"/>
<child link="lidar_link"/>
<!--
 Adjust xyz to place lidar on top of your robot body 
-->
<origin xyz="0 0 0.2" rpy="0 0 0"/>
</joint>

<gazebo reference="lidar_link">
<sensor name="lidar_sensor" type="gpu_lidar">
<pose>0 0 0 0 0 0</pose>
<update_rate>10</update_rate>
<!-- Gazebo internal topic (NOT the ROS2 topic) -->
<!-- Bridge maps this → /scan in ROS2            -->
<topic>lidar</topic>
<gz_frame_id>lidar_link</gz_frame_id>
<!--
 ── Harmonic syntax: <lidar> not <ray> ──────────────────── 
-->
<lidar>
<scan>
<horizontal>
<samples>360</samples>
<resolution>1</resolution>
<min_angle>-3.14159</min_angle>
<max_angle> 3.14159</max_angle>
</horizontal>
<!-- Remove vertical block for 2D lidar -->
</scan>
<range>
<min>0.15</min>
<max>12.0</max>
<resolution>0.01</resolution>
</range>
<noise>
<type>gaussian</type>
<mean>0.0</mean>
<stddev>0.01</stddev>
</noise>
</lidar>
<always_on>true</always_on>
<visualize>true</visualize>
</sensor>
</gazebo>

</robot>